## 复制为 local.properties 后按本机路径修改。
## Flutter / Android SDK 路径（必填）
sdk.dir=C:\\Users\\你的用户名\\AppData\\Local\\Android\\Sdk
flutter.sdk=C:\\flutter

## 正式签名（可选；不填则 release 使用 debug 签名）
# sign.key.alias=your_alias
# sign.key.password=your_key_password
# sign.store.file=C:\\path\\to\\your.keystore
# sign.store.password=your_store_password
